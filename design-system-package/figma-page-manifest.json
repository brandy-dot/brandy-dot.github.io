  "globalRules": [
    "Create pages in the listed order.",
    "Create Variables before components.",
    "Bind every component color, text, spacing, radius and shadow to Variables.",
    "Use 101HR bright blue navigation; do not use generic Ant Design, Arco or Material default styling.",
    "Use admin density and operational hierarchy; do not generate marketing page compositions."
