  "interactionPatterns": {
    "sourceFile": "interaction-guidelines.md",
    "pageModes": [
      {
        "name": "taskProcessing",
        "label": "任务处理型",
        "use": "从非结构化资料生成业务草稿，之后以表格/表单确认为主。"
      },
      {
        "name": "intentRouting",
        "label": "意图分流型",
        "use": "用户描述需求后，AI 识别业务类型并生成可编辑表单草稿。"
      },
      {
        "name": "trustedQA",
        "label": "可信问答型",
        "use": "政策、规则或案例问答，需要结构化答案、来源和追问。"
      },
      {
        "name": "processEmbedded",
        "label": "流程嵌入型",
        "use": "在已有业务对象详情中给出 AI 判断和下一步建议。"
      },
      {
        "name": "conversationAction",
        "label": "对话动作型",
        "use": "多轮澄清后输出可执行动作、草稿或人工接管。"
      },
      {
        "name": "operationsConfiguration",
        "label": "运营配置型",
        "use": "监控 Agent、知识、接口和失败样本，不以前置 AI 输入为主。"
      }
    ],
    "containerModes": [
      {
        "name": "fullPage",
        "use": "完整工作流或独立业务页面。"
      },
      {
        "name": "drawer",
        "use": "保留当前列表/表单上下文的详情、来源或单对象编辑。"
      },
      {
        "name": "modal",
        "use": "高风险、不可逆或阻断式确认。"
      },
      {
        "name": "popover",
        "use": "短说明、字段来源、置信度解释或 tooltip。"
      },
      {
        "name": "inlineExpansion",
        "use": "记录行或过程详情的快速展开。"
      },
      {
        "name": "toast",
        "use": "低风险、非阻断的操作反馈。"
      }
    ],
    "layoutModes": [
      {
        "name": "oneColumnWorkflow",
        "use": "顺序型流程、密集表单或结果表需要全宽。"
      },
      {
        "name": "twoColumnSupport",
        "use": "主对象 + 辅助决策，建议 65/35 或 70/30。"
      },
      {
        "name": "threePaneWorkspace",
        "use": "左导航、中部主列表/对话、右侧详情/结果三者均长期存在。"
      },
      {
        "name": "listDetail",
        "use": "记录或对象选择后查看详情。"
      },
      {
        "name": "chatAction",
        "use": "对话需要和动作面板并存。"
      }
    ],
    "editModes": [
      {
        "name": "inlineTableEdit",
        "use": "低风险、高频、1-3 个字段的行内修正。"
      },
      {
        "name": "inlineFormEdit",
        "use": "表单本身就是主任务。"
      },
